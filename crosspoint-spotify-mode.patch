+#include <gtest/gtest.h>
+
+#include <string>
+
+#include "lib/Spotify/SpotifyNowPlayingParser.h"
+
+namespace {
+
+// Trimmed but structurally faithful currently-playing response.
+constexpr char PLAYING_JSON[] = R"({
+  "timestamp": 1720000000000,
+  "context": {"type": "album", "href": "https://api.spotify.com/v1/albums/x"},
+  "progress_ms": 83500,
+  "item": {
+    "id": "11dFghVXANMlKmJXsNCbNl",
+    "name": "Cut To The Feeling",
+    "duration_ms": 207959,
+    "type": "track",
+    "artists": [
+      {"id": "a1", "name": "Carly Rae Jepsen"},
+      {"id": "a2", "name": "Second Artist"}
+    ],
+    "album": {
+      "id": "0tGPJ0bkWOUmH7MEOR77qc",
+      "name": "Cut To The Feeling",
+      "images": [
+        {"url": "https://i.scdn.co/image/640", "width": 640, "height": 640},
+        {"url": "https://i.scdn.co/image/300", "width": 300, "height": 300},
+        {"url": "https://i.scdn.co/image/64", "width": 64, "height": 64}
+      ]
+    }
+  },
+  "currently_playing_type": "track",
+  "is_playing": true
+})";
+
+TEST(NowPlayingParser, ParsesTrackFields) {
+  SpotifyNowPlaying np;
+  ASSERT_TRUE(SpotifyNowPlayingParser::parse(PLAYING_JSON, np));
+
+  EXPECT_TRUE(np.isPlaying);
+  EXPECT_EQ(np.trackId, "11dFghVXANMlKmJXsNCbNl");
+  EXPECT_EQ(np.title, "Cut To The Feeling");
+  EXPECT_EQ(np.artists, "Carly Rae Jepsen, Second Artist");
+  EXPECT_EQ(np.albumId, "0tGPJ0bkWOUmH7MEOR77qc");
+  EXPECT_EQ(np.progressMs, 83500u);
+  EXPECT_EQ(np.durationMs, 207959u);
+}
+
+TEST(NowPlayingParser, PicksSmallestImageOfAtLeast300px) {
+  SpotifyNowPlaying np;
+  ASSERT_TRUE(SpotifyNowPlayingParser::parse(PLAYING_JSON, np));
+  EXPECT_EQ(np.artUrl, "https://i.scdn.co/image/300");
+}
+
+TEST(NowPlayingParser, FallsBackToLargestWhenAllSmall) {
+  const std::string json = R"({
+    "is_playing": false, "progress_ms": 1,
+    "item": {"id": "t", "name": "n", "duration_ms": 2,
+      "artists": [{"name": "a"}],
+      "album": {"id": "al", "images": [
+        {"url": "u64", "width": 64}, {"url": "u128", "width": 128}]}}})";
+  SpotifyNowPlaying np;
+  ASSERT_TRUE(SpotifyNowPlayingParser::parse(json.c_str(), np));
+  EXPECT_EQ(np.artUrl, "u128");
+  EXPECT_FALSE(np.isPlaying);
+}
+
+TEST(NowPlayingParser, RejectsMissingItem) {
+  SpotifyNowPlaying np;
+  // Ad break / private session: 200 with no usable item.
+  EXPECT_FALSE(SpotifyNowPlayingParser::parse(R"({"is_playing": true, "item": null})", np));
+  EXPECT_FALSE(SpotifyNowPlayingParser::parse("", np));
+  EXPECT_FALSE(SpotifyNowPlayingParser::parse(nullptr, np));
+  EXPECT_FALSE(SpotifyNowPlayingParser::parse("not json", np));
+}
+
+TEST(NowPlayingParser, ToleratesMissingImagesAndArtists) {
+  const std::string json = R"({
+    "is_playing": true, "progress_ms": 5,
+    "item": {"id": "t2", "name": "Song", "duration_ms": 9,
+      "album": {"id": "al2"}}})";
+  SpotifyNowPlaying np;
+  ASSERT_TRUE(SpotifyNowPlayingParser::parse(json.c_str(), np));
+  EXPECT_EQ(np.artUrl, "");
+  EXPECT_EQ(np.artists, "");
+  EXPECT_EQ(np.trackId, "t2");
+}
+
+}  // namespace
