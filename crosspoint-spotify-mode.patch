@@ -0,0 +1,80 @@
+#include <gtest/gtest.h>
+
+#include <cstdint>
+#include <string>
+
+#include "lib/Spotify/SpotifyAuthUtils.h"
+
+namespace {
+
+using namespace SpotifyAuthUtils;
+
+// RFC 4648 test vectors, adjusted for the url-safe alphabet and no padding.
+TEST(Base64UrlEncode, Rfc4648Vectors) {
+  const auto enc = [](const std::string& s) {
+    return base64UrlEncode(reinterpret_cast<const uint8_t*>(s.data()), s.size());
+  };
+  EXPECT_EQ(enc(""), "");
+  EXPECT_EQ(enc("f"), "Zg");
+  EXPECT_EQ(enc("fo"), "Zm8");
+  EXPECT_EQ(enc("foo"), "Zm9v");
+  EXPECT_EQ(enc("foob"), "Zm9vYg");
+  EXPECT_EQ(enc("fooba"), "Zm9vYmE");
+  EXPECT_EQ(enc("foobar"), "Zm9vYmFy");
+}
+
+TEST(Base64UrlEncode, UsesUrlSafeAlphabet) {
+  // 0xFB 0xEF 0xFF encodes to "++//" in standard base64, "--__" in base64url.
+  const uint8_t data[] = {0xFB, 0xEF, 0xFF};
+  EXPECT_EQ(base64UrlEncode(data, sizeof(data)), "--__");
+}
+
+// The PKCE S256 example from RFC 7636 appendix B: the SHA-256 of the sample
+// verifier must encode to this exact challenge. We can't run SHA-256 here
+// (device-side mbedTLS), but we can verify the encoding half with the
+// appendix's raw digest bytes.
+TEST(Base64UrlEncode, Rfc7636AppendixB) {
+  const uint8_t digest[32] = {19,  211, 30,  150, 26,  26,  216, 236, 47,  22,  177, 12, 76,  152, 46,  8,
+                              118, 168, 120, 173, 109, 241, 68,  86,  110, 225, 137, 74, 203, 112, 249, 195};
+  EXPECT_EQ(base64UrlEncode(digest, sizeof(digest)), "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM");
+}
+
+TEST(UrlEncode, EncodesReservedCharacters) {
+  EXPECT_EQ(urlEncode("abc-XYZ_0.9~"), "abc-XYZ_0.9~");
+  EXPECT_EQ(urlEncode("a b&c=d"), "a%20b%26c%3Dd");
+  EXPECT_EQ(urlEncode("http://192.168.1.2/spotify/callback"), "http%3A%2F%2F192.168.1.2%2Fspotify%2Fcallback");
+}
+
+TEST(State, BuildAndMatch) {
+  const std::string state = buildState("deadbeef01234567", "192.168.1.42");
+  EXPECT_EQ(state, "deadbeef01234567~192.168.1.42");
+
+  EXPECT_TRUE(stateMatches(state, "deadbeef01234567"));
+  EXPECT_TRUE(stateMatches("deadbeef01234567", "deadbeef01234567"));  // no bridge suffix
+  EXPECT_FALSE(stateMatches(state, "othertoken000000"));
+  EXPECT_FALSE(stateMatches("deadbeef0123456", "deadbeef01234567"));        // truncated
+  EXPECT_FALSE(stateMatches("deadbeef01234567extra", "deadbeef01234567"));  // wrong separator
+  EXPECT_FALSE(stateMatches(state, ""));
+}
+
+TEST(AuthorizeUrl, ContainsAllPkceParams) {
+  const std::string url =
+      buildAuthorizeUrl("myclientid", "http://192.168.1.2/spotify/callback", "chall-enge_123", "csrf~192.168.1.2");
+
+  EXPECT_EQ(url.rfind("https://accounts.spotify.com/authorize?response_type=code", 0), 0u);
+  EXPECT_NE(url.find("&client_id=myclientid"), std::string::npos);
+  EXPECT_NE(url.find("&redirect_uri=http%3A%2F%2F192.168.1.2%2Fspotify%2Fcallback"), std::string::npos);
+  EXPECT_NE(url.find("&code_challenge_method=S256"), std::string::npos);
+  EXPECT_NE(url.find("&code_challenge=chall-enge_123"), std::string::npos);
+  EXPECT_NE(url.find("&state=csrf~192.168.1.2"), std::string::npos);  // '~' is RFC 3986 unreserved
+  EXPECT_NE(url.find("&scope=user-read-currently-playing%20user-read-playback-state"), std::string::npos);
+}
+
+TEST(TokenBodies, ExchangeAndRefresh) {
+  EXPECT_EQ(buildTokenExchangeBody("th code", "http://x/cb", "cid", "verifier123"),
+            "grant_type=authorization_code&code=th%20code&redirect_uri=http%3A%2F%2Fx%2Fcb&client_id=cid"
+            "&code_verifier=verifier123");
+  EXPECT_EQ(buildRefreshBody("tok/en", "cid"), "grant_type=refresh_token&refresh_token=tok%2Fen&client_id=cid");
+}
+
+}  // namespace
