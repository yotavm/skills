diff --git a/sim_support/include/esp_random.h b/sim_support/include/esp_random.h
new file mode 100644
index 0000000..658efef
--- /dev/null
+++ b/sim_support/include/esp_random.h
@@ -0,0 +1,20 @@
+#pragma once
+// Simulator-only shim for esp_random.h (not yet provided by
+// crosspoint-simulator). Prepended to the include path by [env:simulator]
+// via -Isim_support/include; never used in embedded builds.
+
+#include <cstddef>
+#include <cstdint>
+#include <random>
+
+inline uint32_t esp_random(void) {
+  static std::mt19937 rng{std::random_device{}()};
+  return static_cast<uint32_t>(rng());
+}
+
+inline void esp_fill_random(void* buf, size_t len) {
+  auto* out = static_cast<uint8_t*>(buf);
+  for (size_t i = 0; i < len; i++) {
+    out[i] = static_cast<uint8_t>(esp_random() & 0xFF);
+  }
+}
