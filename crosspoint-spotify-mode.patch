+++ b/src/network/html/SpotifySetupPage.html
@@ -0,0 +1,87 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>CrossPoint - Spotify Setup</title>
+<style>
+  body { font-family: -apple-system, system-ui, sans-serif; margin: 0; background: #f4f4f4; color: #222; }
+  .wrap { max-width: 480px; margin: 0 auto; padding: 16px; }
+  h1 { font-size: 1.3em; }
+  .card { background: #fff; border-radius: 10px; padding: 16px; margin-bottom: 16px; box-shadow: 0 1px 3px rgba(0,0,0,.12); }
+  label { display: block; font-weight: 600; margin: 12px 0 4px; font-size: .9em; }
+  input { width: 100%; box-sizing: border-box; padding: 10px; border: 1px solid #ccc; border-radius: 6px; font-size: 1em; }
+  button { width: 100%; padding: 12px; margin-top: 16px; border: 0; border-radius: 6px; font-size: 1em; font-weight: 600; cursor: pointer; }
+  .primary { background: #1db954; color: #fff; }
+  .secondary { background: #e0e0e0; color: #222; }
+  .hint { font-size: .82em; color: #666; margin-top: 4px; }
+  .status { padding: 10px; border-radius: 6px; margin-bottom: 12px; font-size: .9em; display: none; }
+  .ok { background: #e6f7ec; color: #14602f; display: block; }
+  .err { background: #fdecea; color: #8a1c12; display: block; }
+  code { background: #eee; padding: 1px 5px; border-radius: 4px; word-break: break-all; }
+  ol { padding-left: 20px; font-size: .9em; }
+</style>
+</head>
+<body>
+<div class="wrap">
+  <h1>Spotify Setup</h1>
+
+  <div class="card">
+    <div id="status" class="status"></div>
+    <ol>
+      <li>Create a free app at <b>developer.spotify.com/dashboard</b>.</li>
+      <li>Add a <b>Redirect URI</b> to that app and paste the same value below.
+        <div class="hint">Simplest: <code id="deviceCb">http://&lt;device-ip&gt;/spotify/callback</code>.
+        If Spotify refuses a plain http LAN address, host the bridge page from
+        <code>docs/spotify-redirect.html</code> on any HTTPS site (e.g. GitHub Pages) and use its URL instead.</div>
+      </li>
+      <li>Paste the app's <b>Client ID</b> below, save, then connect.</li>
+    </ol>
+    <label for="clientId">Client ID</label>
+    <input id="clientId" placeholder="32-character Spotify client ID" autocomplete="off">
+    <label for="redirectUri">Redirect URI</label>
+    <input id="redirectUri" placeholder="Leave empty to use this device's callback URL" autocomplete="off">
+    <button class="secondary" onclick="save(false)">Save</button>
+    <button class="primary" onclick="connect()">Save &amp; Connect Spotify</button>
+    <button class="secondary" id="unlinkBtn" style="display:none" onclick="save(true)">Unlink account</button>
+  </div>
+</div>
+<script>
+function show(msg, isErr) {
+  var el = document.getElementById('status');
+  el.textContent = msg;
+  el.className = 'status ' + (isErr ? 'err' : 'ok');
+}
+function load() {
+  fetch('/api/spotify/config').then(function(r){ return r.json(); }).then(function(cfg){
+    document.getElementById('clientId').value = cfg.client_id || '';
+    document.getElementById('redirectUri').value = cfg.redirect_uri || '';
+    document.getElementById('deviceCb').textContent = 'http://' + cfg.device_ip + '/spotify/callback';
+    if (cfg.linked) {
+      show('Account linked. Saving a new config keeps the link; use Unlink to drop it.', false);
+      document.getElementById('unlinkBtn').style.display = 'block';
+    }
+  }).catch(function(){ show('Could not load current config', true); });
+}
+function save(unlink) {
+  var body = {
+    client_id: document.getElementById('clientId').value.trim(),
+    redirect_uri: document.getElementById('redirectUri').value.trim()
+  };
+  if (unlink) body.unlink = true;
+  return fetch('/api/spotify/config', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body) })
+    .then(function(r){
+      if (!r.ok) return r.text().then(function(t){ throw new Error(t); });
+      show(unlink ? 'Account unlinked' : 'Saved', false);
+      if (unlink) document.getElementById('unlinkBtn').style.display = 'none';
+      return true;
+    })
+    .catch(function(e){ show('Save failed: ' + e.message, true); return false; });
+}
+function connect() {
+  save(false).then(function(ok){ if (ok) location.href = '/spotify/login'; });
+}
+load();
+</script>
+</body>
+</html>
