diff --git a/lib/Spotify/SpotifyAuthUtils.cpp b/lib/Spotify/SpotifyAuthUtils.cpp
new file mode 100644
index 0000000..df8da42
--- /dev/null
+++ b/lib/Spotify/SpotifyAuthUtils.cpp
@@ -0,0 +1,87 @@
+#include "SpotifyAuthUtils.h"
+
+namespace {
+constexpr char BASE64URL_ALPHABET[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
+
+bool isUnreserved(const char c) {
+  return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_' ||
+         c == '.' || c == '~';
+}
+}  // namespace
+
+namespace SpotifyAuthUtils {
+
+std::string base64UrlEncode(const uint8_t* data, const size_t len) {
+  std::string out;
+  out.reserve(((len + 2) / 3) * 4);
+  for (size_t i = 0; i < len; i += 3) {
+    const uint32_t remaining = len - i;
+    const uint32_t b0 = data[i];
+    const uint32_t b1 = remaining > 1 ? data[i + 1] : 0;
+    const uint32_t b2 = remaining > 2 ? data[i + 2] : 0;
+    const uint32_t triple = (b0 << 16) | (b1 << 8) | b2;
+    out += BASE64URL_ALPHABET[(triple >> 18) & 0x3F];
+    out += BASE64URL_ALPHABET[(triple >> 12) & 0x3F];
+    if (remaining > 1) out += BASE64URL_ALPHABET[(triple >> 6) & 0x3F];
+    if (remaining > 2) out += BASE64URL_ALPHABET[triple & 0x3F];
+  }
+  return out;
+}
+
+std::string urlEncode(const std::string& value) {
+  static constexpr char HEX[] = "0123456789ABCDEF";
+  std::string out;
+  out.reserve(value.size() * 3);
+  for (const char c : value) {
+    if (isUnreserved(c)) {
+      out += c;
+    } else {
+      const auto b = static_cast<uint8_t>(c);
+      out += '%';
+      out += HEX[b >> 4];
+      out += HEX[b & 0x0F];
+    }
+  }
+  return out;
+}
+
+std::string buildState(const std::string& csrf, const std::string& deviceIp) { return csrf + "~" + deviceIp; }
+
+bool stateMatches(const std::string& receivedState, const std::string& expectedCsrf) {
+  if (expectedCsrf.empty()) return false;
+  if (receivedState.size() < expectedCsrf.size()) return false;
+  if (receivedState.compare(0, expectedCsrf.size(), expectedCsrf) != 0) return false;
+  // Either exact match or followed by the "~<ip>" bridge suffix.
+  return receivedState.size() == expectedCsrf.size() || receivedState[expectedCsrf.size()] == '~';
+}
+
+std::string buildAuthorizeUrl(const std::string& clientId, const std::string& redirectUri,
+                              const std::string& codeChallenge, const std::string& state) {
+  std::string url = "https://accounts.spotify.com/authorize?response_type=code";
+  url += "&client_id=" + urlEncode(clientId);
+  url += "&scope=" + urlEncode("user-read-currently-playing user-read-playback-state");
+  url += "&redirect_uri=" + urlEncode(redirectUri);
+  url += "&code_challenge_method=S256";
+  url += "&code_challenge=" + codeChallenge;  // base64url is already URL-safe
+  url += "&state=" + urlEncode(state);
+  return url;
+}
+
+std::string buildTokenExchangeBody(const std::string& code, const std::string& redirectUri, const std::string& clientId,
+                                   const std::string& codeVerifier) {
+  std::string body = "grant_type=authorization_code";
+  body += "&code=" + urlEncode(code);
+  body += "&redirect_uri=" + urlEncode(redirectUri);
+  body += "&client_id=" + urlEncode(clientId);
+  body += "&code_verifier=" + codeVerifier;  // base64url is already URL-safe
+  return body;
+}
+
+std::string buildRefreshBody(const std::string& refreshToken, const std::string& clientId) {
+  std::string body = "grant_type=refresh_token";
+  body += "&refresh_token=" + urlEncode(refreshToken);
+  body += "&client_id=" + urlEncode(clientId);
+  return body;
+}
+
+}  // namespace SpotifyAuthUtils
diff --git a/lib/Spotify/SpotifyAuthUtils.h b/lib/Spotify/SpotifyAuthUtils.h
new file mode 100644
index 0000000..608b116
--- /dev/null
+++ b/lib/Spotify/SpotifyAuthUtils.h
@@ -0,0 +1,41 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+/**
+ * Pure string helpers for the Spotify OAuth 2.0 PKCE flow.
+ *
+ * No Arduino/ESP-IDF dependencies so the logic is host-testable
+ * (see test/spotify_auth). Device-only pieces (SHA-256, RNG) live
+ * in SpotifyClient.
+ */
+namespace SpotifyAuthUtils {
+
+// RFC 4648 base64url without padding (as required for PKCE code challenges).
+std::string base64UrlEncode(const uint8_t* data, size_t len);
+
+// Percent-encode a string for use as a query parameter value.
+std::string urlEncode(const std::string& value);
+
+// State parameter carries a CSRF token plus the device's LAN IP so an
+// HTTPS-hosted bridge page can forward the OAuth redirect back to the
+// device: "<csrf>~<ip>".
+std::string buildState(const std::string& csrf, const std::string& deviceIp);
+
+// Validates that a received state parameter starts with the expected CSRF
+// token (the "~<ip>" suffix is for the bridge page, not for us).
+bool stateMatches(const std::string& receivedState, const std::string& expectedCsrf);
+
+// Full https://accounts.spotify.com/authorize URL for the PKCE flow.
+std::string buildAuthorizeUrl(const std::string& clientId, const std::string& redirectUri,
+                              const std::string& codeChallenge, const std::string& state);
+
+// application/x-www-form-urlencoded body for the authorization-code exchange.
+std::string buildTokenExchangeBody(const std::string& code, const std::string& redirectUri, const std::string& clientId,
+                                   const std::string& codeVerifier);
+
+// application/x-www-form-urlencoded body for an access-token refresh.
+std::string buildRefreshBody(const std::string& refreshToken, const std::string& clientId);
+
+}  // namespace SpotifyAuthUtils
diff --git a/lib/Spotify/SpotifyClient.cpp b/lib/Spotify/SpotifyClient.cpp
new file mode 100644
index 0000000..96999ba
--- /dev/null
+++ b/lib/Spotify/SpotifyClient.cpp
@@ -0,0 +1,266 @@
+#include "SpotifyClient.h"
+
+#include <Arduino.h>
+#include <ArduinoJson.h>
+#include <Logging.h>
+#include <esp_crt_bundle.h>
+#include <esp_http_client.h>
+#include <esp_random.h>
+#include <mbedtls/sha256.h>
+
+#include <cstring>
+
+#include "SpotifyAuthUtils.h"
+#include "SpotifyStore.h"
+
+int SpotifyClient::lastHttpCode = 0;
+std::string SpotifyClient::accessToken;
+uint32_t SpotifyClient::accessTokenDeadlineMs = 0;
+
+namespace {
+constexpr char TOKEN_URL[] = "https://accounts.spotify.com/api/token";
+constexpr char NOW_PLAYING_URL[] = "https://api.spotify.com/v1/me/player/currently-playing?additional_types=track";
+
+// Small TLS buffers to fit in ESP32-C3's limited heap (~46KB free after
+// WiFi). The now-playing response is the largest payload (~7KB) and is
+// streamed into the response buffer in chunks, so 2KB I/O buffers suffice.
+constexpr int HTTP_BUF_SIZE = 2048;
+
+// See KOReaderSyncClient: the mbedTLS handshake makes many small allocations
+// totalling ~48KB; check aggregate free heap before starting one.
+constexpr uint32_t MIN_HEAP_FOR_TLS = 55000;
+
+// PKCE code verifier: 48 random bytes -> 64 base64url chars (RFC 7636 allows 43-128).
+constexpr size_t PKCE_RANDOM_BYTES = 48;
+
+struct ResponseBuffer {
+  char* data = nullptr;
+  int len = 0;
+  int capacity = 0;
+
+  ~ResponseBuffer() { free(data); }
+
+  bool ensure(int size) {
+    if (size <= capacity) return true;
+    char* newData = (char*)realloc(data, size);
+    if (!newData) return false;
+    data = newData;
+    capacity = size;
+    return true;
+  }
+};
+
+esp_err_t httpEventHandler(esp_http_client_event_t* evt) {
+  auto* buf = static_cast<ResponseBuffer*>(evt->user_data);
+  if (evt->event_id == HTTP_EVENT_ON_DATA && buf) {
+    if (buf->ensure(buf->len + evt->data_len + 1)) {
+      memcpy(buf->data + buf->len, evt->data, evt->data_len);
+      buf->len += evt->data_len;
+      buf->data[buf->len] = '\0';
+    } else {
+      LOG_ERR("SPOT", "Response buffer allocation failed (%d bytes)", evt->data_len);
+    }
+  }
+  return ESP_OK;
+}
+
+esp_http_client_handle_t createClient(const char* url, ResponseBuffer* buf,
+                                      esp_http_client_method_t method = HTTP_METHOD_GET) {
+  esp_http_client_config_t config = {};
+  config.url = url;
+  config.event_handler = httpEventHandler;
+  config.user_data = buf;
+  config.method = method;
+  config.timeout_ms = 15000;
+  config.buffer_size = HTTP_BUF_SIZE;
+  config.buffer_size_tx = HTTP_BUF_SIZE;
+  config.crt_bundle_attach = esp_crt_bundle_attach;
+  return esp_http_client_init(&config);
+}
+
+bool heapAllowsTls(const char* what) {
+  const uint32_t freeHeap = ESP.getFreeHeap();
+  if (freeHeap < MIN_HEAP_FOR_TLS) {
+    LOG_ERR("SPOT", "Insufficient heap for TLS (%s): %u bytes free (need %u)", what, (unsigned)freeHeap,
+            (unsigned)MIN_HEAP_FOR_TLS);
+    return false;
+  }
+  return true;
+}
+}  // namespace
+
+bool SpotifyClient::generatePkce(std::string& outVerifier, std::string& outChallenge) {
+  uint8_t random[PKCE_RANDOM_BYTES];
+  esp_fill_random(random, sizeof(random));
+  outVerifier = SpotifyAuthUtils::base64UrlEncode(random, sizeof(random));
+
+  uint8_t digest[32];
+  if (mbedtls_sha256(reinterpret_cast<const unsigned char*>(outVerifier.c_str()), outVerifier.size(), digest, 0) != 0) {
+    LOG_ERR("SPOT", "SHA-256 for PKCE challenge failed");
+    return false;
+  }
+  outChallenge = SpotifyAuthUtils::base64UrlEncode(digest, sizeof(digest));
+  return true;
+}
+
+std::string SpotifyClient::generateCsrfToken() {
+  uint8_t random[8];
+  esp_fill_random(random, sizeof(random));
+  char hex[17];
+  for (size_t i = 0; i < sizeof(random); i++) {
+    snprintf(&hex[i * 2], 3, "%02x", random[i]);
+  }
+  return std::string(hex, 16);
+}
+
+SpotifyClient::Error SpotifyClient::tokenRequest(const std::string& body) {
+  lastHttpCode = 0;
+  if (!heapAllowsTls("token")) return LOW_MEMORY;
+
+  ResponseBuffer buf;
+  esp_http_client_handle_t client = createClient(TOKEN_URL, &buf, HTTP_METHOD_POST);
+  if (!client) return NETWORK_ERROR;
+
+  if (esp_http_client_set_header(client, "Content-Type", "application/x-www-form-urlencoded") != ESP_OK ||
+      esp_http_client_set_post_field(client, body.c_str(), body.length()) != ESP_OK) {
+    LOG_ERR("SPOT", "Failed to set token request body");
+    esp_http_client_cleanup(client);
+    return NETWORK_ERROR;
+  }
+
+  const esp_err_t err = esp_http_client_perform(client);
+  const int httpCode = esp_http_client_get_status_code(client);
+  lastHttpCode = httpCode;
+  esp_http_client_cleanup(client);
+
+  LOG_DBG("SPOT", "Token response: %d (err: %d)", httpCode, err);
+
+  if (err != ESP_OK) return NETWORK_ERROR;
+  if (httpCode == 400 || httpCode == 401 || httpCode == 403) return AUTH_FAILED;
+  if (httpCode != 200 || !buf.data) return SERVER_ERROR;
+
+  JsonDocument doc;
+  if (deserializeJson(doc, buf.data)) {
+    LOG_ERR("SPOT", "Token JSON parse failed");
+    return JSON_ERROR;
+  }
+
+  const char* newAccess = doc["access_token"] | "";
+  if (newAccess[0] == '\0') return JSON_ERROR;
+  accessToken = newAccess;
+
+  // Refresh one minute early to avoid racing the expiry on a slow poll.
+  const uint32_t expiresIn = doc["expires_in"] | 3600;
+  accessTokenDeadlineMs = millis() + (expiresIn > 120 ? (expiresIn - 60) : expiresIn / 2) * 1000;
+
+  // Spotify may rotate the refresh token; persist it when it does.
+  const char* newRefresh = doc["refresh_token"] | "";
+  if (newRefresh[0] != '\0' && SPOTIFY_STORE.getRefreshToken() != newRefresh) {
+    SPOTIFY_STORE.setRefreshToken(newRefresh);
+    SPOTIFY_STORE.saveToFile();
+  }
+
+  return OK;
+}
+
+SpotifyClient::Error SpotifyClient::exchangeCode(const std::string& code, const std::string& codeVerifier) {
+  if (!SPOTIFY_STORE.hasClientId()) return NO_CLIENT_ID;
+  const std::string body = SpotifyAuthUtils::buildTokenExchangeBody(code, SPOTIFY_STORE.getRedirectUri(),
+                                                                    SPOTIFY_STORE.getClientId(), codeVerifier);
+  return tokenRequest(body);
+}
+
+SpotifyClient::Error SpotifyClient::refreshAccessToken() {
+  if (!SPOTIFY_STORE.hasClientId()) return NO_CLIENT_ID;
+  if (!SPOTIFY_STORE.isLinked()) return NOT_LINKED;
+  const std::string body =
+      SpotifyAuthUtils::buildRefreshBody(SPOTIFY_STORE.getRefreshToken(), SPOTIFY_STORE.getClientId());
+  const Error result = tokenRequest(body);
+  if (result == AUTH_FAILED) {
+    // Refresh token revoked or invalid: the account must be re-linked.
+    accessToken.clear();
+  }
+  return result;
+}
+
+SpotifyClient::Error SpotifyClient::getNowPlaying(SpotifyNowPlaying& out) {
+  if (!SPOTIFY_STORE.isLinked()) return NOT_LINKED;
+
+  const bool tokenStale = accessToken.empty() || static_cast<int32_t>(millis() - accessTokenDeadlineMs) >= 0;
+  if (tokenStale) {
+    const Error refreshResult = refreshAccessToken();
+    if (refreshResult != OK) return refreshResult;
+  }
+
+  for (int attempt = 0; attempt < 2; attempt++) {
+    lastHttpCode = 0;
+    if (!heapAllowsTls("now-playing")) return LOW_MEMORY;
+
+    ResponseBuffer buf;
+    esp_http_client_handle_t client = createClient(NOW_PLAYING_URL, &buf);
+    if (!client) return NETWORK_ERROR;
+
+    const std::string authHeader = "Bearer " + accessToken;
+    if (esp_http_client_set_header(client, "Authorization", authHeader.c_str()) != ESP_OK) {
+      esp_http_client_cleanup(client);
+      return NETWORK_ERROR;
+    }
+
+    const esp_err_t err = esp_http_client_perform(client);
+    const int httpCode = esp_http_client_get_status_code(client);
+    lastHttpCode = httpCode;
+    esp_http_client_cleanup(client);
+
+    LOG_DBG("SPOT", "Now-playing response: %d (err: %d, %d bytes)", httpCode, err, buf.len);
+
+    if (err != ESP_OK) return NETWORK_ERROR;
+
+    if (httpCode == 200 && buf.data) {
+      if (!SpotifyNowPlayingParser::parse(buf.data, out)) return NOTHING_PLAYING;
+      return OK;
+    }
+    if (httpCode == 204) return NOTHING_PLAYING;
+    if (httpCode == 429) return RATE_LIMITED;
+    if (httpCode == 401 && attempt == 0) {
+      const Error refreshResult = refreshAccessToken();
+      if (refreshResult != OK) return refreshResult;
+      continue;  // retry once with the fresh token
+    }
+    if (httpCode == 401 || httpCode == 403) return AUTH_FAILED;
+    return SERVER_ERROR;
+  }
+
+  return SERVER_ERROR;
+}
+
+void SpotifyClient::resetSession() {
+  accessToken.clear();
+  accessTokenDeadlineMs = 0;
+}
+
+const char* SpotifyClient::errorString(const Error error) {
+  switch (error) {
+    case OK:
+      return "Success";
+    case NO_CLIENT_ID:
+      return "No Spotify client ID configured";
+    case NOT_LINKED:
+      return "Spotify account not linked";
+    case NETWORK_ERROR:
+      return "Network error";
+    case AUTH_FAILED:
+      return "Authorization failed - relink account";
+    case SERVER_ERROR:
+      return "Spotify server error";
+    case JSON_ERROR:
+      return "Response parse error";
+    case NOTHING_PLAYING:
+      return "Nothing playing";
+    case RATE_LIMITED:
+      return "Rate limited - slowing down";
+    case LOW_MEMORY:
+      return "Not enough memory - please retry";
+    default:
+      return "Unknown error";
+  }
+}
diff --git a/lib/Spotify/SpotifyClient.h b/lib/Spotify/SpotifyClient.h
new file mode 100644
index 0000000..c9485c7
--- /dev/null
+++ b/lib/Spotify/SpotifyClient.h
@@ -0,0 +1,73 @@
+#pragma once
+#include <string>
+
+#include "SpotifyNowPlayingParser.h"
+
+/**
+ * HTTPS client for the Spotify Web API (OAuth 2.0 PKCE flow).
+ *
+ * Endpoints used:
+ *   POST https://accounts.spotify.com/api/token          - code exchange / refresh
+ *   GET  https://api.spotify.com/v1/me/player/currently-playing
+ *
+ * Modeled on KOReaderSyncClient: per-request esp_http_client with small TLS
+ * buffers and a free-heap guard (the C3 has ~46-50KB free after WiFi and an
+ * mbedTLS handshake consumes ~48KB in aggregate).
+ *
+ * The short-lived access token is kept in RAM only; the refresh token is
+ * persisted via SpotifyStore.
+ */
+class SpotifyClient {
+ public:
+  enum Error {
+    OK = 0,
+    NO_CLIENT_ID,
+    NOT_LINKED,
+    NETWORK_ERROR,
+    AUTH_FAILED,
+    SERVER_ERROR,
+    JSON_ERROR,
+    NOTHING_PLAYING,
+    RATE_LIMITED,
+    LOW_MEMORY,
+  };
+
+  /**
+   * Generate a PKCE code verifier and its S256 challenge.
+   * @return false on RNG/allocation failure
+   */
+  static bool generatePkce(std::string& outVerifier, std::string& outChallenge);
+
+  /** Random hex token for the OAuth `state` CSRF value. */
+  static std::string generateCsrfToken();
+
+  /**
+   * Exchange an authorization code for tokens and persist the refresh token
+   * (SpotifyStore::saveToFile). Uses the store's client ID and redirect URI.
+   */
+  static Error exchangeCode(const std::string& code, const std::string& codeVerifier);
+
+  /** Force-refresh the access token from the stored refresh token. */
+  static Error refreshAccessToken();
+
+  /**
+   * Fetch the currently playing track. Transparently refreshes the access
+   * token when missing/expired and retries once on 401.
+   * @return OK, NOTHING_PLAYING (nothing active / ad break), or an error
+   */
+  static Error getNowPlaying(SpotifyNowPlaying& out);
+
+  /** Drop the in-RAM access token (e.g. after unlinking). */
+  static void resetSession();
+
+  static const char* errorString(Error error);
+
+  /** HTTP status code from the last request (for diagnostics). */
+  static int lastHttpCode;
+
+ private:
+  static Error tokenRequest(const std::string& body);
+
+  static std::string accessToken;
+  static uint32_t accessTokenDeadlineMs;  // millis() timestamp after which the token is stale
+};
diff --git a/lib/Spotify/SpotifyNowPlayingParser.cpp b/lib/Spotify/SpotifyNowPlayingParser.cpp
new file mode 100644
index 0000000..6ddbab2
--- /dev/null
+++ b/lib/Spotify/SpotifyNowPlayingParser.cpp
@@ -0,0 +1,65 @@
+#include "SpotifyNowPlayingParser.h"
+
+#include <ArduinoJson.h>
+
+namespace SpotifyNowPlayingParser {
+
+bool parse(const char* json, SpotifyNowPlaying& out) {
+  if (!json || json[0] == '\0') return false;
+
+  JsonDocument filter;
+  filter["is_playing"] = true;
+  filter["progress_ms"] = true;
+  JsonObject item = filter["item"].to<JsonObject>();
+  item["id"] = true;
+  item["name"] = true;
+  item["duration_ms"] = true;
+  item["artists"][0]["name"] = true;
+  JsonObject album = item["album"].to<JsonObject>();
+  album["id"] = true;
+  album["images"][0]["url"] = true;
+  album["images"][0]["width"] = true;
+
+  JsonDocument doc;
+  const DeserializationError err = deserializeJson(doc, json, DeserializationOption::Filter(filter));
+  if (err) return false;
+
+  JsonVariantConst itemVar = doc["item"];
+  if (itemVar.isNull()) return false;  // e.g. ads, or nothing playing
+
+  out.isPlaying = doc["is_playing"] | false;
+  out.progressMs = doc["progress_ms"] | 0;
+  out.trackId = itemVar["id"] | "";
+  out.title = itemVar["name"] | "";
+  out.durationMs = itemVar["duration_ms"] | 0;
+  out.albumId = itemVar["album"]["id"] | "";
+
+  out.artists.clear();
+  for (JsonVariantConst artist : itemVar["artists"].as<JsonArrayConst>()) {
+    const char* name = artist["name"] | "";
+    if (name[0] == '\0') continue;
+    if (!out.artists.empty()) out.artists += ", ";
+    out.artists += name;
+  }
+
+  // Spotify returns images largest-first (typically 640/300/64). Pick the
+  // smallest one that is still >= 300px so the e-ink dither has enough
+  // source resolution without downloading the 640px original.
+  out.artUrl.clear();
+  int bestWidth = 0;
+  for (JsonVariantConst img : itemVar["album"]["images"].as<JsonArrayConst>()) {
+    const char* url = img["url"] | "";
+    const int width = img["width"] | 0;
+    if (url[0] == '\0') continue;
+    const bool better = out.artUrl.empty() || (width >= 300 && (bestWidth < 300 || width < bestWidth)) ||
+                        (width < 300 && bestWidth < 300 && width > bestWidth);
+    if (better) {
+      out.artUrl = url;
+      bestWidth = width;
+    }
+  }
+
+  return !out.trackId.empty();
+}
+
+}  // namespace SpotifyNowPlayingParser
diff --git a/lib/Spotify/SpotifyNowPlayingParser.h b/lib/Spotify/SpotifyNowPlayingParser.h
new file mode 100644
index 0000000..f63e4c7
--- /dev/null
+++ b/lib/Spotify/SpotifyNowPlayingParser.h
@@ -0,0 +1,30 @@
+#pragma once
+#include <cstdint>
+#include <string>
+
+/**
+ * The subset of Spotify's "currently playing" response that the UI needs.
+ */
+struct SpotifyNowPlaying {
+  bool isPlaying = false;
+  std::string trackId;
+  std::string title;
+  std::string artists;  // all artist names joined with ", "
+  std::string albumId;
+  std::string artUrl;  // preferred album image (~300px, see parser)
+  uint32_t progressMs = 0;
+  uint32_t durationMs = 0;
+};
+
+namespace SpotifyNowPlayingParser {
+
+/**
+ * Parse the JSON body of GET /v1/me/player/currently-playing into `out`.
+ * Uses an ArduinoJson filter so only the needed fields are materialised
+ * (the full response is ~7KB+; the filtered document stays under ~1KB).
+ *
+ * Returns false on JSON errors or when no track item is present.
+ */
+bool parse(const char* json, SpotifyNowPlaying& out);
+
+}  // namespace SpotifyNowPlayingParser
