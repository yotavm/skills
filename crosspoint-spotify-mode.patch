+#include "SpotifyStore.h"
+
+#include <Logging.h>
+#include <ObfuscationUtils.h>
+
+void SpotifyStore::toJson(JsonDocument& doc) const {
+  doc["client_id"] = getClientId();
+  doc["redirect_uri"] = getRedirectUri();
+  doc["refresh_token_obf"] = obfuscation::obfuscateToBase64(getRefreshToken());
+}
+
+bool SpotifyStore::fromJson(JsonVariantConst doc) {
+  clientId = doc["client_id"] | "";
+  redirectUri = doc["redirect_uri"] | "";
+
+  bool ok = false;
+  refreshToken = obfuscation::deobfuscateFromBase64(doc["refresh_token_obf"] | "", &ok);
+  if (!ok) {
+    refreshToken.clear();
+  }
+
+  return true;
+}
+
+void SpotifyStore::setConfig(const std::string& id, const std::string& redirect) {
+  clientId = id;
+  redirectUri = redirect;
+  LOG_DBG("SPOT", "Spotify config updated (client id %s)", clientId.empty() ? "cleared" : "set");
+}
+
+void SpotifyStore::setRefreshToken(const std::string& token) { refreshToken = token; }
+
+void SpotifyStore::clearLink() { refreshToken.clear(); }
diff --git a/lib/Spotify/SpotifyStore.h b/lib/Spotify/SpotifyStore.h
new file mode 100644
index 0000000..5a71abb
--- /dev/null
+++ b/lib/Spotify/SpotifyStore.h
@@ -0,0 +1,49 @@
+#pragma once
+#include <ArduinoJson.h>
+#include <PersistableStore.h>
+
+#include <string>
+
+/**
+ * Singleton store for the Spotify integration, persisted on the SD card.
+ *
+ * Holds the user's Spotify application client ID, the OAuth redirect URI
+ * registered on that application, and the long-lived refresh token obtained
+ * from the PKCE link flow. The refresh token is XOR-obfuscated with the
+ * device MAC and base64-encoded before writing (same scheme as the other
+ * credential stores — device-bound, not cryptographically secure).
+ *
+ * Access tokens are short-lived and deliberately NOT persisted; they live in
+ * SpotifyClient's RAM only.
+ */
+class SpotifyStore : public PersistableStore<SpotifyStore> {
+ private:
+  std::string clientId;
+  std::string redirectUri;
+  std::string refreshToken;
+
+  SpotifyStore() = default;
+  ~SpotifyStore() = default;
+
+  friend class PersistableStore<SpotifyStore>;
+
+ public:
+  static const char* getFilePath() { return "/.crosspoint/spotify.json"; }
+  void toJson(JsonDocument& doc) const;
+  bool fromJson(JsonVariantConst doc);
+
+  const std::string& getClientId() const { return clientId; }
+  const std::string& getRedirectUri() const { return redirectUri; }
+  const std::string& getRefreshToken() const { return refreshToken; }
+
+  void setConfig(const std::string& id, const std::string& redirect);
+  void setRefreshToken(const std::string& token);
+
+  bool hasClientId() const { return !clientId.empty(); }
+  bool isLinked() const { return !refreshToken.empty() && hasClientId(); }
+
+  // Drop the account link (refresh token) but keep the app configuration.
+  void clearLink();
+};
+
+#define SPOTIFY_STORE SpotifyStore::getInstance()
