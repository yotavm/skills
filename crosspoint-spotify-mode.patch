diff --git a/lib/Spotify/SpotifyClient.cpp b/lib/Spotify/SpotifyClient.cpp
index 96999ba..100baf9 100644
--- a/lib/Spotify/SpotifyClient.cpp
+++ b/lib/Spotify/SpotifyClient.cpp
@@ -94,8 +94,17 @@ bool SpotifyClient::generatePkce(std::string& outVerifier, std::string& outChall
   esp_fill_random(random, sizeof(random));
   outVerifier = SpotifyAuthUtils::base64UrlEncode(random, sizeof(random));
 
+  // Context API rather than the one-shot mbedtls_sha256(): it is the common
+  // subset between device mbedTLS and the simulator's shim.
   uint8_t digest[32];
-  if (mbedtls_sha256(reinterpret_cast<const unsigned char*>(outVerifier.c_str()), outVerifier.size(), digest, 0) != 0) {
+  mbedtls_sha256_context ctx;
+  mbedtls_sha256_init(&ctx);
+  const bool ok = mbedtls_sha256_starts(&ctx, 0) == 0 &&
+                  mbedtls_sha256_update(&ctx, reinterpret_cast<const unsigned char*>(outVerifier.c_str()),
+                                        outVerifier.size()) == 0 &&
+                  mbedtls_sha256_finish(&ctx, digest) == 0;
+  mbedtls_sha256_free(&ctx);
+  if (!ok) {
     LOG_ERR("SPOT", "SHA-256 for PKCE challenge failed");
     return false;
   }
