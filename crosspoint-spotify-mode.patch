index 0000000..5edb6e1
--- /dev/null
+++ b/src/activities/network/SpotifyActivity.cpp
@@ -0,0 +1,403 @@
+#include "SpotifyActivity.h"
+
+#include <Bitmap.h>
+#include <GfxRenderer.h>
+#include <HalStorage.h>
+#include <I18n.h>
+#include <JpegToBmpConverter.h>
+#include <Logging.h>
+#include <Memory.h>
+#include <SpotifyClient.h>
+#include <SpotifyStore.h>
+#include <WiFi.h>
+
+#include "SilentRestart.h"
+#include "activities/network/WifiSelectionActivity.h"
+#include "components/UITheme.h"
+#include "fontIds.h"
+#include "network/HttpDownloader.h"
+#include "network/SpotifyAuthServer.h"
+#include "util/QrUtils.h"
+
+namespace {
+constexpr char CACHE_DIR[] = "/.crosspoint/spotify";
+constexpr char ART_JPG_PATH[] = "/.crosspoint/spotify/art.jpg";
+constexpr char ART_BMP_PATH[] = "/.crosspoint/spotify/art.bmp";
+
+// Artwork square rendered on screen; the 300px Spotify image is upscaled
+// slightly during the BMP conversion so dithering happens at output size.
+constexpr int ART_SIZE = 360;
+
+constexpr uint32_t POLL_MS_PLAYING = 10000;
+constexpr uint32_t POLL_MS_IDLE = 30000;
+constexpr uint32_t POLL_MS_RATE_LIMITED = 60000;
+
+// De-ghost with a HALF_REFRESH after this many FAST_REFRESH paints.
+constexpr int FAST_REFRESHES_BEFORE_CLEAN = 8;
+
+// Downloading art needs a TLS session; skip artwork (keep text) when the
+// heap could not take the handshake. Same rationale as SpotifyClient.
+constexpr uint32_t MIN_HEAP_FOR_ART_DOWNLOAD = 60000;
+
+void formatMs(char* out, const size_t outSize, const uint32_t ms) {
+  const uint32_t totalSec = ms / 1000;
+  snprintf(out, outSize, "%u:%02u", (unsigned)(totalSec / 60), (unsigned)(totalSec % 60));
+}
+}  // namespace
+
+void SpotifyActivity::onEnter() {
+  Activity::onEnter();
+  SPOTIFY_STORE.loadFromFile();
+
+  if (WiFi.status() == WL_CONNECTED) {
+    enterSetupOrPolling();
+    return;
+  }
+
+  shouldTearDownWifiOnExit = true;
+  startActivityForResult(std::make_unique<WifiSelectionActivity>(renderer, mappedInput),
+                         [this](const ActivityResult& result) { onWifiSelectionComplete(!result.isCancelled); });
+}
+
+void SpotifyActivity::onExit() {
+  stopAuthServer();
+  Activity::onExit();
+
+  if (shouldTearDownWifiOnExit && WiFi.getMode() != WIFI_MODE_NULL) {
+    WiFi.disconnect(false);
+    delay(30);
+    silentRestart();
+  }
+}
+
+void SpotifyActivity::onWifiSelectionComplete(const bool connected) {
+  if (!connected) {
+    LOG_INF("SPOT", "WiFi selection cancelled, leaving Spotify mode");
+    onGoHome(HomeMenuItem::SPOTIFY);
+    return;
+  }
+  enterSetupOrPolling();
+}
+
+void SpotifyActivity::enterSetupOrPolling() {
+  if (SPOTIFY_STORE.isLinked()) {
+    state = State::POLL_FIRST;
+  } else if (startAuthServer()) {
+    state = State::SETUP;
+  } else {
+    fail(tr(STR_SPOTIFY_NO_WIFI));
+    return;
+  }
+  requestUpdate();
+}
+
+bool SpotifyActivity::startAuthServer() {
+  if (!authServer) {
+    authServer = makeUniqueNoThrow<SpotifyAuthServer>();
+    if (!authServer) {
+      LOG_ERR("SPOT", "OOM: SpotifyAuthServer");
+      return false;
+    }
+  }
+  return authServer->begin();
+}
+
+void SpotifyActivity::stopAuthServer() {
+  if (authServer) {
+    authServer->stop();
+  }
+}
+
+bool SpotifyActivity::skipLoopDelay() { return authServer && authServer->isRunning(); }
+
+void SpotifyActivity::loop() {
+  switch (state) {
+    case State::WIFI_WAIT:
+      return;
+
+    case State::SETUP: {
+      authServer->handleClient();
+      if (authServer->consumeConfigChanged()) {
+        requestUpdate();  // client ID arrived: switch the QR to the login URL
+      }
+      if (authServer->getLinkResult() == SpotifyAuthServer::LinkResult::FAILED && !linkFailureRendered) {
+        linkFailureRendered = true;
+        requestUpdate();
+      }
+      if (authServer->getLinkResult() == SpotifyAuthServer::LinkResult::SUCCESS) {
+        stopAuthServer();
+        state = State::POLL_FIRST;
+        requestUpdate();
+        return;
+      }
+      if (mappedInput.wasPressed(MappedInputManager::Button::Back)) {
+        onGoHome(HomeMenuItem::SPOTIFY);
+      }
+      return;
+    }
+
+    case State::POLL_FIRST:
+      // Paint the "connecting" screen before the blocking network calls.
+      requestUpdateAndWait();
+      pollNowPlaying();
+      return;
+
+    case State::NOW_PLAYING: {
+      if (mappedInput.wasPressed(MappedInputManager::Button::Back)) {
+        onGoHome(HomeMenuItem::SPOTIFY);
+        return;
+      }
+      const bool forcePoll = mappedInput.wasReleased(MappedInputManager::Button::Confirm);
+      if (forcePoll || millis() - lastPollMs >= pollIntervalMs) {
+        pollNowPlaying();
+      }
+      return;
+    }
+
+    case State::SHOW_ERROR:
+      if (mappedInput.wasPressed(MappedInputManager::Button::Back)) {
+        onGoHome(HomeMenuItem::SPOTIFY);
+        return;
+      }
+      if (mappedInput.wasReleased(MappedInputManager::Button::Confirm)) {
+        state = SPOTIFY_STORE.isLinked() ? State::POLL_FIRST : State::WIFI_WAIT;
+        if (state == State::WIFI_WAIT) enterSetupOrPolling();
+        requestUpdate();
+      }
+      return;
+  }
+}
+
+void SpotifyActivity::pollNowPlaying() {
+  SpotifyNowPlaying fresh;
+  const SpotifyClient::Error err = SpotifyClient::getNowPlaying(fresh);
+  lastPollMs = millis();
+
+  switch (err) {
+    case SpotifyClient::OK: {
+      const bool trackChanged = !hasTrack || fresh.trackId != nowPlaying.trackId;
+      nowPlaying = fresh;
+      hasTrack = true;
+      lastFetchMs = millis();
+      pollIntervalMs = nowPlaying.isPlaying ? POLL_MS_PLAYING : POLL_MS_IDLE;
+      if (nowPlaying.albumId != lastAlbumId) {
+        updateAlbumArt();
+      }
+      if (trackChanged) wantHalfRefresh = true;
+      state = State::NOW_PLAYING;
+      requestUpdate();
+      return;
+    }
+
+    case SpotifyClient::NOTHING_PLAYING:
+      if (hasTrack) wantHalfRefresh = true;
+      hasTrack = false;
+      pollIntervalMs = POLL_MS_IDLE;
+      state = State::NOW_PLAYING;
+      requestUpdate();
+      return;
+
+    case SpotifyClient::RATE_LIMITED:
+      pollIntervalMs = POLL_MS_RATE_LIMITED;
+      state = State::NOW_PLAYING;
+      return;
+
+    case SpotifyClient::NOT_LINKED:
+    case SpotifyClient::NO_CLIENT_ID:
+    case SpotifyClient::AUTH_FAILED:
+      // Token revoked or config wiped: go back through the link flow.
+      LOG_ERR("SPOT", "Re-link needed: %s", SpotifyClient::errorString(err));
+      SpotifyClient::resetSession();
+      if (startAuthServer()) {
+        state = State::SETUP;
+        requestUpdate();
+      } else {
+        fail(SpotifyClient::errorString(err));
+      }
+      return;
+
+    default:
+      fail(SpotifyClient::errorString(err));
+      return;
+  }
+}
+
+void SpotifyActivity::updateAlbumArt() {
+  artBmpPath.clear();
+  lastAlbumId = nowPlaying.albumId;
+  if (nowPlaying.artUrl.empty()) return;
+
+  if (ESP.getFreeHeap() < MIN_HEAP_FOR_ART_DOWNLOAD) {
+    LOG_ERR("SPOT", "Skipping art download, heap too low (%u)", (unsigned)ESP.getFreeHeap());
+    return;
+  }
+
+  if (!Storage.ensureDirectoryExists(CACHE_DIR)) {
+    LOG_ERR("SPOT", "Cannot create %s", CACHE_DIR);
+    return;
+  }
+
+  if (HttpDownloader::downloadToFile(nowPlaying.artUrl, ART_JPG_PATH) != HttpDownloader::OK) {
+    LOG_ERR("SPOT", "Album art download failed");
+    return;
+  }
+
+  bool converted = false;
+  {
+    HalFile jpegFile;
+    HalFile bmpFile;
+    if (Storage.openFileForRead("SPOT", ART_JPG_PATH, jpegFile) &&
+        Storage.openFileForWrite("SPOT", ART_BMP_PATH, bmpFile)) {
+      converted = JpegToBmpConverter::jpegFileTo1BitBmpStreamWithSize(jpegFile, bmpFile, ART_SIZE, ART_SIZE);
+    }
+    // HalFile destructors close both files here (DESTRUCTOR_CLOSES_FILE).
+  }
+  Storage.remove(ART_JPG_PATH);
+
+  if (!converted) {
+    LOG_ERR("SPOT", "Album art conversion failed");
+    Storage.remove(ART_BMP_PATH);
+    return;
+  }
+  artBmpPath = ART_BMP_PATH;
+}
+
+void SpotifyActivity::fail(const char* message) {
+  snprintf(errorMessage, sizeof(errorMessage), "%s", message);
+  state = State::SHOW_ERROR;
+  requestUpdate();
+}
+
+void SpotifyActivity::render(RenderLock&&) {
+  renderer.clearScreen();
+
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  GUI.drawHeader(renderer, Rect{0, metrics.topPadding, renderer.getScreenWidth(), metrics.headerHeight},
+                 tr(STR_SPOTIFY));
+
+  switch (state) {
+    case State::WIFI_WAIT:
+      renderMessage(tr(STR_SPOTIFY_CONNECTING), nullptr);
+      break;
+    case State::SETUP:
+      renderSetup();
+      break;
+    case State::POLL_FIRST:
+      renderMessage(tr(STR_SPOTIFY_CONNECTING), nullptr);
+      break;
+    case State::NOW_PLAYING:
+      renderNowPlaying();
+      return;  // renderNowPlaying picks its own refresh mode
+    case State::SHOW_ERROR:
+      renderMessage(errorMessage, tr(STR_SPOTIFY_RETRY_HINT));
+      drawBottomHints();
+      break;
+  }
+
+  renderer.displayBuffer();
+}
+
+void SpotifyActivity::renderSetup() const {
+  const int pageWidth = renderer.getScreenWidth();
+  const bool needsConfig = !SPOTIFY_STORE.hasClientId();
+
+  const std::string url = needsConfig ? authServer->getBaseUrl() : authServer->getBaseUrl() + "spotify/login";
+  const char* hint = needsConfig ? tr(STR_SPOTIFY_SETUP_HINT) : tr(STR_SPOTIFY_LINK_HINT);
+
+  renderer.drawCenteredText(UI_12_FONT_ID, 130, hint, true, EpdFontFamily::BOLD);
+
+  constexpr int QR_SIZE = 280;
+  QrUtils::drawQrCode(renderer, Rect{(pageWidth - QR_SIZE) / 2, 180, QR_SIZE, QR_SIZE}, url);
+
+  renderer.drawCenteredText(UI_10_FONT_ID, 180 + QR_SIZE + 40,
+                            renderer.truncatedText(UI_10_FONT_ID, url.c_str(), pageWidth - 40).c_str());
+
+  if (authServer->getLinkResult() == SpotifyAuthServer::LinkResult::FAILED) {
+    renderer.drawCenteredText(UI_10_FONT_ID, 180 + QR_SIZE + 80, tr(STR_SPOTIFY_AUTH_FAILED));
+  }
+
+  const auto labels = mappedInput.mapLabels(tr(STR_BACK), "", "", "");
+  GUI.drawButtonHints(renderer, labels.btn1, labels.btn2, labels.btn3, labels.btn4);
+}
+
+void SpotifyActivity::renderNowPlaying() {
+  const int pageWidth = renderer.getScreenWidth();
+
+  if (!hasTrack) {
+    renderMessage(tr(STR_SPOTIFY_NOTHING_PLAYING), nullptr);
+    drawBottomHints();
+  } else {
+    const int artTop = 80;
+    bool artDrawn = false;
+    if (!artBmpPath.empty()) {
+      HalFile file;
+      if (Storage.openFileForRead("SPOT", artBmpPath, file)) {
+        Bitmap bmp(file);
+        if (bmp.parseHeaders() == BmpReaderError::Ok) {
+          renderer.drawBitmap1Bit(bmp, (pageWidth - bmp.getWidth()) / 2, artTop + (ART_SIZE - bmp.getHeight()) / 2,
+                                  ART_SIZE, ART_SIZE);
+          artDrawn = true;
+        }
+      }
+    }
+    if (!artDrawn) {
+      // Placeholder frame where the artwork would be.
+      renderer.drawRect((pageWidth - ART_SIZE) / 2, artTop, ART_SIZE, ART_SIZE, true);
+    }
+
+    const int textTop = artTop + ART_SIZE + 50;
+    renderer.drawCenteredText(
+        UI_12_FONT_ID, textTop,
+        renderer.truncatedText(UI_12_FONT_ID, nowPlaying.title.c_str(), pageWidth - 40, EpdFontFamily::BOLD).c_str(),
+        true, EpdFontFamily::BOLD);
+    renderer.drawCenteredText(
+        UI_10_FONT_ID, textTop + 40,
+        renderer.truncatedText(UI_10_FONT_ID, nowPlaying.artists.c_str(), pageWidth - 40).c_str());
+
+    // Estimate the live position from the last poll timestamp.
+    uint32_t elapsed = nowPlaying.progressMs;
+    if (nowPlaying.isPlaying) elapsed += millis() - lastFetchMs;
+    if (nowPlaying.durationMs > 0 && elapsed > nowPlaying.durationMs) elapsed = nowPlaying.durationMs;
+
+    const auto& metrics = UITheme::getInstance().getMetrics();
+    const int barY = textTop + 90;
+    GUI.drawProgressBar(renderer, Rect{40, barY, pageWidth - 80, metrics.progressBarHeight}, elapsed,
+                        nowPlaying.durationMs > 0 ? nowPlaying.durationMs : 1);
+
+    char elapsedStr[8];
+    char durationStr[8];
+    char timeLine[32];
+    formatMs(elapsedStr, sizeof(elapsedStr), elapsed);
+    formatMs(durationStr, sizeof(durationStr), nowPlaying.durationMs);
+    if (nowPlaying.isPlaying) {
+      snprintf(timeLine, sizeof(timeLine), "%s / %s", elapsedStr, durationStr);
+    } else {
+      snprintf(timeLine, sizeof(timeLine), "%s / %s  -  %s", elapsedStr, durationStr, tr(STR_SPOTIFY_PAUSED));
+    }
+    renderer.drawCenteredText(UI_10_FONT_ID, barY + metrics.progressBarHeight + 26, timeLine);
+
+    drawBottomHints();
+  }
+
+  HalDisplay::RefreshMode mode = HalDisplay::FAST_REFRESH;
+  fastRefreshCount++;
+  if (wantHalfRefresh || fastRefreshCount >= FAST_REFRESHES_BEFORE_CLEAN) {
+    mode = HalDisplay::HALF_REFRESH;
+    wantHalfRefresh = false;
+    fastRefreshCount = 0;
+  }
+  renderer.displayBuffer(mode);
+}
+
+void SpotifyActivity::renderMessage(const char* line1, const char* line2) const {
+  const int midY = renderer.getScreenHeight() / 2;
+  renderer.drawCenteredText(UI_12_FONT_ID, midY - 20, line1, true, EpdFontFamily::BOLD);
+  if (line2 && line2[0] != '\0') {
+    renderer.drawCenteredText(UI_10_FONT_ID, midY + 15, line2);
+  }
+}
+
+void SpotifyActivity::drawBottomHints() const {
+  const auto labels = mappedInput.mapLabels(tr(STR_BACK), tr(STR_SPOTIFY_REFRESH), "", "");
+  GUI.drawButtonHints(renderer, labels.btn1, labels.btn2, labels.btn3, labels.btn4);
+}
diff --git a/src/activities/network/SpotifyActivity.h b/src/activities/network/SpotifyActivity.h
new file mode 100644
index 0000000..464e338
--- /dev/null
+++ b/src/activities/network/SpotifyActivity.h
@@ -0,0 +1,77 @@
+#pragma once
+
+#include <SpotifyNowPlayingParser.h>
+
+#include <memory>
+#include <string>
+
+#include "activities/Activity.h"
+
+class SpotifyAuthServer;
+
+/**
+ * Spotify "Now Playing" mode: shows dithered album artwork, track/artist and
+ * a progress bar for whatever is playing on the user's Spotify account.
+ *
+ * First run walks through a QR-driven setup (client ID + OAuth PKCE link)
+ * served by a small on-device web server; after that the activity polls the
+ * Web API and only needs WiFi.
+ *
+ * E-ink strategy: FAST_REFRESH for progress ticks, HALF_REFRESH on track
+ * changes and periodically to clear ghosting. Artwork is downloaded once per
+ * album, converted to a dithered 1-bit BMP and cached on the SD card.
+ */
+class SpotifyActivity final : public Activity {
+ public:
+  explicit SpotifyActivity(GfxRenderer& renderer, MappedInputManager& mappedInput)
+      : Activity("Spotify", renderer, mappedInput) {}
+
+  void onEnter() override;
+  void onExit() override;
+  void loop() override;
+  void render(RenderLock&&) override;
+
+  // Keep the loop snappy while serving the setup pages; relax to the normal
+  // 10ms cadence while polling.
+  bool skipLoopDelay() override;
+  // A now-playing screen must not fall asleep mid-album.
+  bool preventAutoSleep() override { return true; }
+
+ private:
+  enum class State {
+    WIFI_WAIT,    // WifiSelectionActivity in front
+    SETUP,        // auth server running, waiting for config/link via phone
+    POLL_FIRST,   // linked; render "connecting" then do the first poll
+    NOW_PLAYING,  // steady state: poll on a timer
+    SHOW_ERROR,
+  };
+
+  void onWifiSelectionComplete(bool connected);
+  void enterSetupOrPolling();
+  bool startAuthServer();
+  void stopAuthServer();
+  void pollNowPlaying();
+  void updateAlbumArt();
+  void fail(const char* message);
+
+  void renderSetup() const;
+  void renderNowPlaying();
+  void renderMessage(const char* line1, const char* line2) const;
+  void drawBottomHints() const;
+
+  State state = State::WIFI_WAIT;
+  bool shouldTearDownWifiOnExit = false;
+  std::unique_ptr<SpotifyAuthServer> authServer;
+
+  SpotifyNowPlaying nowPlaying;
+  bool hasTrack = false;
+  std::string artBmpPath;       // dithered 1-bit BMP of the current album art ("" = none)
+  std::string lastAlbumId;      // album of the art currently cached/rendered
+  uint32_t lastPollMs = 0;      // millis() of the last completed poll
+  uint32_t lastFetchMs = 0;     // millis() when nowPlaying.progressMs was sampled
+  uint32_t pollIntervalMs = 0;  // 0 = poll immediately
+  int fastRefreshCount = 0;
+  bool wantHalfRefresh = false;
+  bool linkFailureRendered = false;
+  char errorMessage[96] = {0};
+};
diff --git a/src/network/SpotifyAuthServer.cpp b/src/network/SpotifyAuthServer.cpp
new file mode 100644
index 0000000..35be7bb
--- /dev/null
+++ b/src/network/SpotifyAuthServer.cpp
@@ -0,0 +1,182 @@
+#include "SpotifyAuthServer.h"
+
+#include <ArduinoJson.h>
+#include <Logging.h>
+#include <SpotifyAuthUtils.h>
+#include <SpotifyClient.h>
+#include <SpotifyStore.h>
+#include <WebServer.h>
+#include <WiFi.h>
+
+#include "html/SpotifySetupPageHtml.generated.h"
+
+namespace {
+constexpr int HTTP_PORT = 80;
+
+// Small self-contained result pages; the phone browser lands here at the end
+// of the OAuth redirect chain, so keep them dependency-free.
+constexpr char LINKED_PAGE[] =
+    "<html><body style='font-family:sans-serif;text-align:center;padding-top:3em'>"
+    "<h2>&#10003; Spotify linked</h2><p>You can close this page. Check your CrossPoint screen.</p></body></html>";
+constexpr char FAILED_PAGE_PREFIX[] =
+    "<html><body style='font-family:sans-serif;text-align:center;padding-top:3em'>"
+    "<h2>Spotify link failed</h2><p>";
+constexpr char FAILED_PAGE_SUFFIX[] = "</p><p><a href='/spotify/login'>Try again</a></p></body></html>";
+}  // namespace
+
+SpotifyAuthServer::SpotifyAuthServer() = default;
+SpotifyAuthServer::~SpotifyAuthServer() { stop(); }
+
+bool SpotifyAuthServer::begin() {
+  if (running) return true;
+  if (WiFi.status() != WL_CONNECTED) {
+    LOG_ERR("SPOT", "Cannot start Spotify auth server without WiFi");
+    return false;
+  }
+
+  server.reset(new (std::nothrow) WebServer(HTTP_PORT));
+  if (!server) {
+    LOG_ERR("SPOT", "OOM: WebServer");
+    return false;
+  }
+
+  server->on("/", HTTP_GET, [this] { handleRoot(); });
+  server->on("/api/spotify/config", HTTP_GET, [this] { handleGetConfig(); });
+  server->on("/api/spotify/config", HTTP_POST, [this] { handlePostConfig(); });
+  server->on("/spotify/login", HTTP_GET, [this] { handleLogin(); });
+  server->on("/spotify/callback", HTTP_GET, [this] { handleCallback(); });
+  server->onNotFound([this] { server->send(404, "text/plain", "Not found"); });
+
+  server->begin();
+  running = true;
+  linkResult = LinkResult::NONE;
+  LOG_INF("SPOT", "Spotify auth server on %s", getBaseUrl().c_str());
+  return true;
+}
+
+void SpotifyAuthServer::stop() {
+  if (!running) return;
+  server->stop();
+  server.reset();
+  running = false;
+  codeVerifier.clear();
+  csrf.clear();
+}
+
+void SpotifyAuthServer::handleClient() {
+  if (running) server->handleClient();
+}
+
+bool SpotifyAuthServer::consumeConfigChanged() {
+  const bool changed = configChanged;
+  configChanged = false;
+  return changed;
+}
+
+std::string SpotifyAuthServer::getBaseUrl() const {
+  return std::string("http://") + WiFi.localIP().toString().c_str() + "/";
+}
+
+void SpotifyAuthServer::handleRoot() const {
+  server->sendHeader("Content-Encoding", "gzip");
+  server->send_P(200, "text/html", SpotifySetupPageHtml, sizeof(SpotifySetupPageHtml));
+}
+
+void SpotifyAuthServer::handleGetConfig() const {
+  JsonDocument doc;
+  doc["client_id"] = SPOTIFY_STORE.getClientId();
+  doc["redirect_uri"] = SPOTIFY_STORE.getRedirectUri();
+  doc["linked"] = SPOTIFY_STORE.isLinked();
+  doc["device_ip"] = WiFi.localIP().toString();
+  std::string body;
+  serializeJson(doc, body);
+  server->send(200, "application/json", body.c_str());
+}
+
+void SpotifyAuthServer::handlePostConfig() {
+  if (!server->hasArg("plain")) {
+    server->send(400, "text/plain", "Missing JSON body");
+    return;
+  }
+
+  JsonDocument doc;
+  if (deserializeJson(doc, server->arg("plain"))) {
+    server->send(400, "text/plain", "Invalid JSON");
+    return;
+  }
+
+  const char* clientId = doc["client_id"] | "";
+  const char* redirectUri = doc["redirect_uri"] | "";
+  if (clientId[0] == '\0') {
+    server->send(400, "text/plain", "client_id is required");
+    return;
+  }
+
+  SPOTIFY_STORE.setConfig(clientId, redirectUri);
+  if (doc["unlink"] | false) {
+    SPOTIFY_STORE.clearLink();
+    SpotifyClient::resetSession();
+  }
+  SPOTIFY_STORE.saveToFile();
+  configChanged = true;
+  server->send(200, "application/json", "{\"ok\":true}");
+}
+
+void SpotifyAuthServer::handleLogin() {
+  if (!SPOTIFY_STORE.hasClientId()) {
+    server->send(400, "text/plain", "Set the client ID on the setup page first");
+    return;
+  }
+
+  std::string challenge;
+  if (!SpotifyClient::generatePkce(codeVerifier, challenge)) {
+    server->send(500, "text/plain", "PKCE generation failed");
+    return;
+  }
+  csrf = SpotifyClient::generateCsrfToken();
+
+  // Default the redirect URI to this device's own callback when unset.
+  std::string redirectUri = SPOTIFY_STORE.getRedirectUri();
+  if (redirectUri.empty()) {
+    redirectUri = getBaseUrl() + "spotify/callback";
+    SPOTIFY_STORE.setConfig(SPOTIFY_STORE.getClientId(), redirectUri);
+    SPOTIFY_STORE.saveToFile();
+  }
+
+  const std::string state = SpotifyAuthUtils::buildState(csrf, WiFi.localIP().toString().c_str());
+  const std::string url =
+      SpotifyAuthUtils::buildAuthorizeUrl(SPOTIFY_STORE.getClientId(), redirectUri, challenge, state);
+
+  server->sendHeader("Location", url.c_str());
+  server->send(302, "text/plain", "");
+}
+
+void SpotifyAuthServer::handleCallback() {
+  char failReason[64] = "Unknown error";
+
+  if (server->hasArg("error")) {
+    snprintf(failReason, sizeof(failReason), "Spotify said: %s", server->arg("error").c_str());
+  } else if (!server->hasArg("code") || codeVerifier.empty()) {
+    snprintf(failReason, sizeof(failReason), "Missing authorization code");
+  } else if (!SpotifyAuthUtils::stateMatches(server->arg("state").c_str(), csrf)) {
+    snprintf(failReason, sizeof(failReason), "State mismatch - start again from the device");
+  } else {
+    // Blocking TLS exchange (~2-4s); the phone browser waits for the result.
+    const SpotifyClient::Error err = SpotifyClient::exchangeCode(server->arg("code").c_str(), codeVerifier);
+    codeVerifier.clear();
+    csrf.clear();
+    if (err == SpotifyClient::OK) {
+      linkResult = LinkResult::SUCCESS;
+      server->send(200, "text/html", LINKED_PAGE);
+      LOG_INF("SPOT", "Spotify account linked");
+      return;
+    }
+    snprintf(failReason, sizeof(failReason), "%s (HTTP %d)", SpotifyClient::errorString(err),
+             SpotifyClient::lastHttpCode);
+  }
+
+  linkResult = LinkResult::FAILED;
+  LOG_ERR("SPOT", "Spotify link failed: %s", failReason);
+  std::string page = std::string(FAILED_PAGE_PREFIX) + failReason + FAILED_PAGE_SUFFIX;
+  server->send(400, "text/html", page.c_str());
+}
diff --git a/src/network/SpotifyAuthServer.h b/src/network/SpotifyAuthServer.h
new file mode 100644
index 0000000..42bd432
--- /dev/null
+++ b/src/network/SpotifyAuthServer.h
@@ -0,0 +1,60 @@
+#pragma once
+#include <memory>
+#include <string>
+
+class WebServer;
+
+/**
+ * Minimal HTTP server for the one-time Spotify setup + OAuth PKCE link flow.
+ *
+ * Owned and pumped (handleClient) by SpotifyActivity while it is in the
+ * setup/link states, then stopped — it is intentionally NOT part of
+ * CrossPointWebServer so the Spotify mode never pays for the file-transfer
+ * server (websockets, upload buffers) and vice versa.
+ *
+ * Routes:
+ *   GET  /                    setup page (client ID + redirect URI form)
+ *   GET  /api/spotify/config  current config as JSON
+ *   POST /api/spotify/config  save config (JSON body)
+ *   GET  /spotify/login       generates PKCE + state, 302 to Spotify authorize
+ *   GET  /spotify/callback    OAuth redirect target: exchanges code for tokens
+ *
+ * The callback URL can be reached either directly (redirect URI set to
+ * http://<device-ip>/spotify/callback, where Spotify permits it) or via an
+ * HTTPS bridge page that forwards the code to the device IP carried in the
+ * OAuth state parameter (see docs/spotify.md).
+ */
+class SpotifyAuthServer {
+ public:
+  enum class LinkResult { NONE, SUCCESS, FAILED };
+
+  SpotifyAuthServer();
+  ~SpotifyAuthServer();
+
+  // Requires WiFi STA to be connected. Returns false otherwise.
+  bool begin();
+  void stop();
+  void handleClient();
+  bool isRunning() const { return running; }
+
+  LinkResult getLinkResult() const { return linkResult; }
+  // True when a config save happened since the last call (UI refresh hint).
+  bool consumeConfigChanged();
+
+  // e.g. "http://192.168.1.42/" - QR payload for the setup screen.
+  std::string getBaseUrl() const;
+
+ private:
+  void handleRoot() const;
+  void handleGetConfig() const;
+  void handlePostConfig();
+  void handleLogin();
+  void handleCallback();
+
+  std::unique_ptr<WebServer> server;
+  std::string codeVerifier;
+  std::string csrf;
+  LinkResult linkResult = LinkResult::NONE;
+  bool configChanged = false;
+  bool running = false;
+};
diff --git a/src/network/html/SpotifySetupPage.html b/src/network/html/SpotifySetupPage.html
